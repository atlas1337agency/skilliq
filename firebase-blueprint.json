{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the learning platform.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the user."
        },
        "displayName": {
          "type": "string",
          "description": "The display name of the user."
        },
        "photoURL": {
          "type": "string",
          "description": "The URL of the user's profile photo."
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "The role of the user."
        }
      },
      "required": ["uid", "email", "role"]
    },
    "CourseProgress": {
      "title": "CourseProgress",
      "description": "A user's progress in a specific course.",
      "type": "object",
      "properties": {
        "courseId": {
          "type": "string",
          "description": "The ID of the course."
        },
        "completedVideoIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of completed video IDs."
        },
        "currentVideoId": {
          "type": "string",
          "description": "The ID of the currently active video."
        },
        "isCompleted": {
          "type": "boolean",
          "description": "Whether the course is completed."
        },
        "completionDate": {
          "type": "string",
          "format": "date-time",
          "description": "The date the course was completed."
        }
      },
      "required": ["courseId", "completedVideoIds", "isCompleted"]
    },
    "Course": {
      "title": "Course",
      "description": "A learning course or masterclass.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "instructor": { "type": "string" },
        "instructorAvatar": { "type": "string" },
        "instructorUrl": { "type": "string" },
        "thumbnail": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "isSingleVideo": { "type": "boolean" },
        "language": { "type": "string" },
        "videos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "duration": { "type": "string" },
              "youtubeId": { "type": "string" },
              "description": { "type": "string" },
              "language": { "type": "string" },
              "resources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": { "type": "string" },
                    "url": { "type": "string" },
                    "logoUrl": { "type": "string" }
                  },
                  "required": ["title", "url"]
                }
              }
            },
            "required": ["id", "title", "youtubeId"]
          }
        }
      },
      "required": ["id", "title", "description", "category", "isSingleVideo", "videos", "thumbnail"]
    },
    "LearningPath": {
      "title": "LearningPath",
      "description": "A path grouping multiple courses.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "courseIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "icon": { "type": "string" }
      },
      "required": ["id", "title", "description", "courseIds", "icon"]
    },
    "Banner": {
      "title": "Banner",
      "description": "An advertisement banner displayed on the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "placement": { "type": "string" },
        "desktopImageUrl": { "type": "string" },
        "mobileImageUrl": { "type": "string" },
        "targetUrl": { "type": "string" },
        "language": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "placement", "desktopImageUrl", "mobileImageUrl", "isActive"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A push notification displayed to users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "linkLogo": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "message", "isActive"]
    },
    "Report": {
      "title": "Report",
      "description": "A user-submitted broken video or content issue report.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "categoryId": { "type": "string" },
        "videoId": { "type": "string" },
        "videoTitle": { "type": "string" },
        "youtubeId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "issue": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "resolvedAt": { "type": "number" },
        "resolvedBy": { "type": "string" }
      },
      "required": ["type", "courseId", "courseTitle", "videoId", "videoTitle", "youtubeId", "status", "createdAt"]
    },
    "Book": {
      "title": "Book",
      "description": "A curated book with a YouTube video summary/explanation, creator profile, category, and optional purchase link.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "coverImage": { "type": "string" },
        "youtubeUrl": { "type": "string" },
        "youtubeId": { "type": "string" },
        "videoTitle": { "type": "string" },
        "videoThumbnail": { "type": "string" },
        "videoDuration": { "type": "string" },
        "youtubeName": { "type": "string" },
        "youtubeAvatar": { "type": "string" },
        "youtubeChannelUrl": { "type": "string" },
        "buyUrl": { "type": "string" },
        "language": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "author", "category", "youtubeId"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "A private community post created by an admin for logged-in members.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "paragraph": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "language": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "paragraph", "category", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "A support ticket and conversation thread between a user and an admin, supporting screenshots and .txt file attachments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNumber": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userAvatar": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "unreadByAdmin": { "type": "boolean" },
        "unreadByUser": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "ticketNumber", "userId", "subject", "category", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/users/{userId}/progress/{courseId}": {
      "schema": { "$ref": "#/entities/CourseProgress" },
      "description": "Stores user progress for specific courses."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Global catalog of courses."
    },
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Global catalog of curated books and video summaries."
    },
    "/learningPaths/{pathId}": {
      "schema": { "$ref": "#/entities/LearningPath" },
      "description": "Global catalog of learning paths."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Global catalog of banners."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Global catalog of notifications."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "User submitted issue and broken video reports."
    },
    "/community_posts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Private community posts visible only to authenticated users."
    },
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Support tickets opened by users to converse with admins."
    }
  }
}
